{
  "title": "GenMotion — launch film",
  "aspect": "16:9",
  "fps": 30,
  "style": {
    "palette": { "bg": "#efeeea", "ink": "#0e0e0e", "accent": "#ff5b1f", "muted": "#7a7771" },
    "font": "Inter Tight",
    "accentFont": "Instrument Serif",
    "grain": 0.04,
    "vignette": 0.12,
    "imageStyle": ""
  },
  "scenes": [
    {
      "name": "Idea", "duration": 3.4, "background": "solid",
      "layers": [
        { "type": "kicker", "text": "GenMotion", "position": "top-left", "start": 0.1, "duration": 3.2 },
        { "type": "kicker", "text": "Open source", "position": "top-right", "start": 0.2, "duration": 3.1 },
        { "type": "headline", "text": "Type an *idea.*", "reveal": "mask", "start": 0.25, "duration": 3.0 },
        { "type": "frame", "style": "brackets", "start": 0, "duration": 3.4 }
      ]
    },
    {
      "name": "Glass", "duration": 4.6, "background": "solid", "transition": { "type": "blur", "duration": 0.6 },
      "layers": [
        { "type": "headline", "text": "motion.", "size": "xl", "reveal": "rise", "start": 0.1, "duration": 4.4 },
        { "type": "kicker", "text": "Get a finished film", "position": "bottom-left", "start": 0.4, "duration": 4.0 },
        { "type": "kicker", "text": "Frame-accurate MP4", "position": "bottom-right", "start": 0.5, "duration": 3.9 },
        { "type": "glass", "size": 0.46, "zoom": 1.5, "style": "orb", "start": 0.3, "duration": 4.2 }
      ]
    },
    {
      "name": "Models", "duration": 4.2, "background": "grid", "transition": { "type": "wipe", "duration": 0.6 },
      "layers": [
        { "type": "counter", "from": 0, "to": 17, "suffix": "", "label": "image models", "position": "center", "start": 0.1, "duration": 4.0 },
        { "type": "chips", "items": ["Seedream", "Qwen-Image", "Kling", "FLUX", "GPT Image", "Imagen"], "position": "bottom", "start": 0.7, "duration": 3.4 }
      ]
    },
    {
      "name": "Steps", "duration": 4.2, "background": "solid", "transition": { "type": "slide", "duration": 0.6 },
      "layers": [
        { "type": "list", "title": "How it works", "items": ["Direct the storyboard", "Generate every scene", "Animate the type", "Export the MP4"], "position": "left", "start": 0.1, "duration": 4.0 },
        { "type": "glass", "size": 0.3, "zoom": 1.35, "style": "pill", "start": 1.2, "duration": 2.9 }
      ]
    },
    {
      "name": "Keys", "duration": 3.6, "background": "solid", "transition": { "type": "dip", "duration": 0.5 },
      "layers": [
        { "type": "headline", "text": "Your keys. Your *machine.*", "size": "l", "reveal": "blur", "start": 0.1, "duration": 3.4 },
        { "type": "subtitle", "text": "Bring any image model. Nothing leaves your computer.", "position": "bottom", "start": 0.8, "duration": 2.7 }
      ]
    },
    {
      "name": "End", "duration": 3.8, "background": "solid", "transition": { "type": "zoom", "duration": 0.6 },
      "layers": [
        { "type": "logo", "text": "genmotion.", "start": 0.1, "duration": 3.7 },
        { "type": "cta", "text": "github.com/blixvip/GenMotion", "position": "bottom", "start": 1.3, "duration": 2.5 }
      ]
    }
  ]
}
