# GenMotion reads keys from this file (copy it to .env) or from the API keys panel in the app,
# which writes .env for you. You only need keys for the models you want to use.

# ---------- Image models: global ----------
OPENAI_API_KEY=            # GPT Image          https://platform.openai.com/api-keys
GEMINI_API_KEY=            # Nano Banana, Imagen 4  https://aistudio.google.com/apikey
BFL_API_KEY=               # FLUX               https://dashboard.bfl.ai/
IDEOGRAM_API_KEY=          # Ideogram 3.0       https://ideogram.ai/manage-api
RECRAFT_API_KEY=           # Recraft V3         https://www.recraft.ai/profile/api
STABILITY_API_KEY=         # Stable Image       https://platform.stability.ai/account/keys
XAI_API_KEY=               # Grok Imagine       https://console.x.ai/

# ---------- Image models: China ----------
ARK_API_KEY=               # ByteDance Seedream (BytePlus ModelArk)  https://console.byteplus.com/ark
DASHSCOPE_API_KEY=         # Alibaba Qwen-Image + Wan (Model Studio)   https://modelstudio.console.alibabacloud.com/
KLING_ACCESS_KEY=          # Kuaishou Kling (needs both)               https://app.klingai.com/global/dev
KLING_SECRET_KEY=
ZHIPU_API_KEY=             # Zhipu CogView-4 (+ GLM director)          https://open.bigmodel.cn/usercenter/apikeys
MINIMAX_API_KEY=           # MiniMax Image-01 (+ MiniMax director)     https://www.minimax.io/platform
TENCENT_SECRET_ID=         # Tencent Hunyuan Image (needs both)        https://console.cloud.tencent.com/cam/capi
TENCENT_SECRET_KEY=

# ---------- One key, every model ----------
FAL_KEY=                   # fal.ai             https://fal.ai/dashboard/keys
REPLICATE_API_TOKEN=       # Replicate          https://replicate.com/account/api-tokens

# ---------- Directors (write the storyboard) ----------
ANTHROPIC_API_KEY=         # Claude             https://console.anthropic.com/settings/keys
DEEPSEEK_API_KEY=          # DeepSeek           https://platform.deepseek.com/api_keys
MOONSHOT_API_KEY=          # Kimi               https://platform.moonshot.ai/console/api-keys
OPENROUTER_API_KEY=        # any model          https://openrouter.ai/keys
# OpenAI, Gemini, Qwen (DASHSCOPE), GLM (ZHIPU), MiniMax and Grok (XAI) reuse the keys above.

# ---------- Optional ----------
# GENMOTION_DIRECTOR=deepseek          # which director "Auto" picks first
# DEEPSEEK_DIRECTOR_MODEL=deepseek-chat # override any director's model: <ID>_DIRECTOR_MODEL
# PORT=4520
# Mainland-China endpoints (defaults are the international ones):
# ARK_BASE_URL=https://ark.cn-beijing.volces.com/api/v3
# DASHSCOPE_BASE_URL=https://dashscope.aliyuncs.com
# DASHSCOPE_COMPAT_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
# KLING_BASE_URL=https://api-beijing.klingai.com
# MINIMAX_BASE_URL=https://api.minimaxi.com
# MINIMAX_CHAT_URL=https://api.minimaxi.com/v1
# ZHIPU_BASE_URL=https://api.z.ai/api/paas/v4   (z.ai international accounts)
# TENCENT_REGION=ap-guangzhou
